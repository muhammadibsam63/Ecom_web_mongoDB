{
  "name": "ai-commerce-platform",
  "version": "1.0.0",
  "description": "Full-stack AI-powered e-commerce platform with MERN stack, Gemini AI, and premium UI",
  "private": true,
  "scripts": {
    "install:all": "npm install --prefix backend && npm install --prefix frontend",
    "dev:backend": "npm run dev --prefix backend",
    "dev:frontend": "npm run dev --prefix frontend",
    "dev": "concurrently \"npm run dev:backend\" \"npm run dev:frontend\"",
    "seed": "npm run seed --prefix backend",
    "build": "npm run build --prefix frontend",
    "test": "npm test --prefix backend"
  },
  "keywords": [
    "ecommerce",
    "mern",
    "ai",
    "gemini",
    "react",
    "nodejs",
    "mongodb"
  ],
  "author": "AI Commerce Team",
  "license": "MIT",
  "devDependencies": {
    "concurrently": "^9.2.5"
  }
}
